{
  "name": "bts-creative",
  "productName": "BTS Creative",
  "version": "1.2.0",
  "description": "BTS Creative \u2014 free and open-source creative suite for students: PDF Pro, Photo, Vector and Video.",
  "main": "main.js",
  "author": {
    "name": "Bhoomiputra Tech Solutions Pvt Ltd",
    "email": "btspl99@gmail.com"
  },
  "homepage": "https://creative.btspl.tech",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  },
  "build": {
    "appId": "tech.btspl.creative",
    "productName": "BTS Creative",
    "copyright": "Copyright \u00a9 2026 Bhoomiputra Tech Solutions Pvt Ltd",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "stt-worker.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,openbsd_*,musl_*,linux_arm64,linux_armhf,linux_ia32,linux_loong64,linux_riscv64d,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/build/koffi/*/*.{lib,exp,pdb}",
      "!node_modules/koffi/lib/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://creative.btspl.tech/updates/",
        "channel": "latest"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "btsp",
        "name": "BTS Photo Project",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "btsv",
        "name": "BTS Vector Project",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "btsvid",
        "name": "BTS Video Project",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BTS-Creative-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "LICENSE.txt"
          ]
        },
        {
          "from": "vendor/vosk/win",
          "to": "vosk/win",
          "filter": [
            "*.dll"
          ]
        },
        {
          "from": "vendor/vosk/model-en-us",
          "to": "vosk/model-en-us"
        },
        {
          "from": "vendor/vosk/model-hi",
          "to": "vosk/model-hi"
        },
        {
          "from": "vendor/vosk",
          "to": "vosk",
          "filter": [
            "LICENSE*",
            "NOTICE*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BTS Creative",
      "uninstallDisplayName": "BTS Creative",
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "extraResources": [
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "LICENSE.txt"
          ]
        },
        {
          "from": "vendor/vosk/linux",
          "to": "vosk/linux",
          "filter": [
            "libvosk.so"
          ]
        },
        {
          "from": "vendor/vosk/model-en-us",
          "to": "vosk/model-en-us"
        },
        {
          "from": "vendor/vosk/model-hi",
          "to": "vosk/model-hi"
        },
        {
          "from": "vendor/vosk",
          "to": "vosk",
          "filter": [
            "LICENSE*",
            "NOTICE*"
          ]
        }
      ]
    },
    "asarUnpack": [
      "node_modules/koffi/**/*.node"
    ]
  },
  "devDependencies": {
    "ag-psd": "^31.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jspdf": "^4.2.1",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "svg2pdf.js": "^2.8.1"
  }
}
